{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bo-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3200"],
      "port": 3200
    },
    {
      "name": "bo-mock",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--watch", "mock/server.mjs"],
      "env": { "MOCK_FE_ORIGIN": "http://localhost:3200" },
      "port": 8090
    },
    {
      "name": "bo-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3200"],
      "port": 3200
    }
  ]
}
